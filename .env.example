# ToyyibPay Configuration
# Get these from ToyyibPay Dashboard -> Settings -> API Keys
TOYYIBPAY_USER_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_HOSTNAME=toyyibpay.com
PAYMENTS_ENABLED=false

# Google OAuth Client ID (Required for ListenEZ Google Drive integration)
VITE_CLIENT_ID=73430242023-m62f0jhvtjbiih249k201r2bf5634r9c.apps.googleusercontent.com

# AI provider keys are server-only. Never set VITE_GEMINI_API_KEY.

# Base URL for the app (used for return/callback URLs)
# In production, this would be your actual domain
VITE_APP_URL=https://ez-academy.my

# Server-only OpenAI key for all AI feedback. Never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_FEEDBACK_MODEL=gpt-4o-mini
# Payment server must use the public HTTPS app address, never a preview hostname.
APP_BASE_URL="https://ez-academy.my"
TOYYIBPAY_CALLBACK_URL="https://ez-academy.my/api/tx/callback"
# Optional gateway QR. Direct bank QR does not need this.
TOYYIBPAY_DUITNOW_QR_ENABLED="false"

# Migration staging only: task endpoint stays disabled until test users are configured.
MIGRATION_TEST_UIDS=
# Use an existing API model available to this OpenAI project.
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
# Server-only Firebase service account JSON for the SAME existing project.
# Configure through Netlify environment settings; never commit its value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Gemini fallback can be added to the server provider interface later.
MIGRATION_MODE=staging
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
AI_REQUESTS_PER_USER_DAILY=150
AI_REQUESTS_GLOBAL_DAILY=500
PAYMENT_SANDBOX=false

# Set true only after original-domain release verification.
CUTOVER_VERIFIED=false
