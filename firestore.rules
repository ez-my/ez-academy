rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Identity check against a trusted email
      return isSignedIn() && request.auth.token.email.lower() == 'ezacademy.my@gmail.com' && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'goal', 'level', 'onboardingCompleted'])
        && data.keys().size() <= 60
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 100
        && data.goal in ['SPM', 'MUET', 'PROFESSIONAL']
        && data.level in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED']
        && data.onboardingCompleted is bool
        && (data.get('plan', 'free') is string)
        && (data.get('credits', 0) is int)
        && (data.get('streak', 0) is int)
        && (data.get('points', 0) is int);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'planId', 'amount', 'status'])
        && data.keys().size() <= 15
        && data.userId is string && data.userId.size() <= 128
        && data.planId is string && data.planId.size() <= 64
        && data.amount is number
        && data.status in ['PENDING', 'SUCCESS', 'FAILED']
        && (data.get('billCode', '') is string);
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'type', 'subject', 'message', 'status', 'createdAt'])
        && data.keys().size() <= 10
        && data.userId == request.auth.uid
        && data.userEmail is string && data.userEmail.size() <= 256
        && data.type in ['FEEDBACK', 'COMPLAINT', 'SUGGESTION', 'OTHER']
        && data.subject is string && data.subject.size() <= 200
        && data.message is string && data.message.size() <= 5000
        && data.status == 'PENDING';
    }

    // --- Path Rules ---

    // 1. Transactions
    match /transactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // Trusted payment server only; Admin SDK bypasses rules.
    }
    match /payment_receipts/{path=**} { allow read, write: if false; }
    match /payment_invoices/{id} { allow read, write: if false; }
    match /system_config/{id} { allow read, write: if false; }

    // 2. Users & Profile Data
    match /users/{userId} {
      // Full profile documents contain private fields. The public leaderboard
      // is served separately by the API with a restricted field allowlist.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && incoming().uid == request.auth.uid && incoming().get('plan', 'free') == 'free'
        && incoming().get('credits', 0) >= 0 && incoming().get('credits', 0) <= 3
        && !incoming().keys().hasAny(['planExpiresAt','lastPaymentAt','lastTransactionId']);
      allow update: if isValidUser(incoming()) && incoming().uid == existing().uid &&
        (isAdmin() || (isOwner(userId) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['plan','planExpiresAt','planUpdatedAt','lastPaymentAt','lastTransactionId']) &&
          incoming().get('credits',0) >= 0 && incoming().get('credits',0) <= existing().get('credits',0)));
      allow delete: if isAdmin();

      // User Subcollections
      match /sessions/{sessionId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(sessionId);
        allow update: if isOwner(userId) && isValidId(sessionId);
        allow delete: if isAdmin();
      }
      
      match /reminders/{reminderId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(reminderId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /completed_questions/{questionId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(questionId);
        allow delete: if isAdmin();
      }
    }

    // Affiliate balances, codes and payout details are server-owned.
    match /affiliate_accounts/{id} { allow read, write: if false; }
    match /affiliate_codes/{id} { allow read, write: if false; }
    match /affiliate_commissions/{id} { allow read, write: if false; }
    match /affiliate_claims/{id} { allow read, write: if false; }
    match /reward_codes/{id} { allow read, write: if false; }
    match /reward_redemptions/{code}/users/{id} { allow read, write: if false; }
    match /reward_user_history/{id}/items/{code} { allow read, write: if false; }

    // 3. Global Question Bank
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(questionId);
    }

    // 4. Modules Configuration
    match /modules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(moduleId);
    }

    // 5. Feedback
    match /feedback/{feedbackId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(feedbackId) && isValidFeedback(incoming());
      allow update, delete: if isAdmin();
    }

    // 6. Activity Logs
    match /activity_logs/{logId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if isAdmin();
    }

    // 7. Site Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. System Check
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Published prices — written only by the server through the Admin SDK, which
    // bypasses these rules. Clients read prices through /api/pricing instead, so no
    // client access is granted here.
    match /pricing/{docId} {
      allow read, write: if false;
    }
    match /pricing_versions/{version} {
      allow read, write: if false;
    }

    // 10. Collection Group Queries
    match /{path=**}/sessions/{sessionId} {
      allow list: if isAdmin();
    }
  }
}
